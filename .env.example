# Postgres connection string. On Vercel: Storage -> Create Database -> Neon -> Connect (sets DATABASE_URL automatically)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ccm
# Groq API key (server-side only, never sent to the browser)
GROQ_API_KEY=
# Model used by the investigation agent and copilot (Groq-hosted OpenAI open-weight model)
GROQ_MODEL=openai/gpt-oss-120b
# Any long random string; signs login sessions
SESSION_SECRET=change-me-to-a-long-random-string
# Protects /api/cron (Vercel sends it automatically as a Bearer token)
CRON_SECRET=change-me
